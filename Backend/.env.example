# AI Provider: 'ollama' (default, local vision model) or 'gemini' (Google Gemini API)
AI_PROVIDER=ollama

# Local Ollama Settings (Qwen 2.5 VL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Google Gemini API Settings (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database
DATABASE_URL=sqlite:///./bhulekh.db

